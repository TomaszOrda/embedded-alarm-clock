        [ "r3:2", "led2:C", "green", [ ] ],
        [ "led2:A", "esp:3V3", "red", [ "h-72", "v10"] ],
        
        [ "buzz:2", "esp:D2", "green", [ "v10"] ],
        [ "buzz:1", "esp:GND", "black", [ "v40", "h107", "v100"] ],

        [ "esp:D2", "r5:1", "green", [ "h-40", "v40"] ],
        [ "r5:2", "esp:GND", "black", [ "h35", "v40"] ],
        
        [ "rtc1:SDA", "esp:D4", "blue", [ "h15", "v5" ] ],
        [ "rtc1:SCL", "esp:D5", "green", [  ] ],
        [ "rtc1:SQW", "esp:D3", "purple", [ "h15", "v5" ] ],
        [ "rtc1:GND", "esp:GND", "black", [ "h25", "v-142", "h170", "v-130" ] ],
        [ "rtc1:5V", "esp:5V", "red", [ "h20", "v-137", "h163", "v-130" ] ],
        
        [ "epd1:VCC", "esp:3V3", "grey", [ "h-15", "v5" ] ],
        [ "epd1:GND", "esp:GND", "brown", [ ] ],
        [ "epd1:DIN", "esp:D10", "blue", [ "h-20", "v100" ] ],
        [ "epd1:CLK", "esp:D8", "yellow", [ "h-25", "v100" ] ],
        [ "epd1:CS", "esp:D9", "orange", [ "h-30", "v100" ] ],
        [ "epd1:DC", "esp:D6", "green", [ "h-160", "v100" ] ],
        [ "epd1:RST", "esp:D0", "white", [ "h-145", "v100" ] ],
        [ "epd1:BUSY", "esp:D1", "purple", [ "h-150", "v100" ] ]
