        [ "buzz:2", "esp:D2", "green", [ "v10"] ],
        [ "buzz:1", "esp:GND", "black", [ "v40", "h107", "v100"] ],

        [ "esp:D2", "r5:1", "green", [ "h-40", "v40"] ],
        [ "r5:2", "esp:GND", "black", [ "h35", "v40"] ],
        
        [ "rtc1:SDA", "esp:D4", "blue", [ "h15", "v5" ] ],
        [ "rtc1:SCL", "esp:D5", "green", [  ] ],
        [ "rtc1:SQW", "esp:D3", "purple", [ "h15", "v5" ] ],
