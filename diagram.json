{
    "version": 1,
    "author": "Tomasz Orda",
    "editor": "wokwi",
    "parts": [
        {
            "type": "board-xiao-esp32-c3",
            "id": "esp",
            "top": 0,
            "left": 0,
            "attrs": {
                "flashSize": "16"
            }
        },
        { "type": "board-epaper-2in9", "id": "epd1", "top": -77, "left": 120, "attrs": {} }
    ],
    "connections": [
        [ "esp:TX", "$serialMonitor:RX", "", [] ],
        [ "esp:RX", "$serialMonitor:TX", "", [] ],
        [ "epd1:VCC", "esp:3V3", "red", [ "h-15", "v5" ] ],
        [ "epd1:GND", "esp:GND", "black", [ ] ],
        [ "epd1:DIN", "esp:D10", "green", [ "h-20", "v100" ] ],
        [ "epd1:CLK", "esp:D8", "green", [ "h-25", "v100" ] ],
        [ "epd1:CS", "esp:D9", "green", [ "h-30", "v100" ] ],
        [ "epd1:DC", "esp:D1", "green", [ "h-140", "v100" ] ],
        [ "epd1:RST", "esp:D2", "green", [ "h-145", "v100" ] ],
        [ "epd1:BUSY", "esp:D6", "green", [ "h-150", "v100" ] ]
    ],
    "serialMonitor": {
        "display": "terminal",
        "convertEol": true
    }
}
